# =============================================================================
# Archon Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Required variables must be set; optional variables have sensible defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Database Configuration
# -----------------------------------------------------------------------------
# Supabase project URL (Cloud: https://xxx.supabase.co, Local: http://localhost:8000)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key (NOT the anon key!)
# Find this in: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# REQUIRED: Service Ports
# -----------------------------------------------------------------------------
# Main API server port
ARCHON_SERVER_PORT=8181

# MCP server port (for Claude/Cursor/Windsurf integration)
ARCHON_MCP_PORT=8051

# AI Agents service port (when enabled)
ARCHON_AGENTS_PORT=8052

# -----------------------------------------------------------------------------
# OPTIONAL: API Keys
# -----------------------------------------------------------------------------
# OpenAI API key for embeddings and completions
# Can also be set via the Archon UI settings page
OPENAI_API_KEY=sk-your-openai-api-key-here

# Logfire token for observability (optional)
# LOGFIRE_TOKEN=your-logfire-token-here

# -----------------------------------------------------------------------------
# OPTIONAL: Server Configuration
# -----------------------------------------------------------------------------
# Host to bind services to (default: localhost for Docker, 0.0.0.0 for direct)
# HOST=localhost

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO

# Transport mode for MCP: sse or streamable-http (default: sse)
# TRANSPORT=sse

# -----------------------------------------------------------------------------
# OPTIONAL: RAG Strategies
# -----------------------------------------------------------------------------
# Enable contextual embeddings (adds context to chunks before embedding)
# USE_CONTEXTUAL_EMBEDDINGS=false

# Enable hybrid search (combines semantic + keyword search)
# USE_HYBRID_SEARCH=true

# Enable agentic RAG (uses AI to refine queries)
# USE_AGENTIC_RAG=true

# Enable reranking (reorders results by relevance)
# USE_RERANKING=true

# -----------------------------------------------------------------------------
# OPTIONAL: Agents Service
# -----------------------------------------------------------------------------
# Enable AI agents service (requires --profile agents in docker compose)
# AGENTS_ENABLED=false

# URL for agents service (auto-configured in Docker)
# AGENTS_SERVICE_URL=http://archon-agents:8052

# URL for API service (auto-configured in Docker)
# API_SERVICE_URL=http://archon-server:8181

# -----------------------------------------------------------------------------
# OPTIONAL: Frontend Configuration
# -----------------------------------------------------------------------------
# Frontend UI port
# ARCHON_UI_PORT=3737

# Allowed hosts for Vite dev server (comma-separated)
# VITE_ALLOWED_HOSTS=

# Show React Query devtools in UI
# VITE_SHOW_DEVTOOLS=false

# Production mode
# PROD=false

# -----------------------------------------------------------------------------
# OPTIONAL: Git Configuration (Harness Tools)
# -----------------------------------------------------------------------------
# Git execution mode: "local" or "remote"
# Use "remote" when working over SSHFS to avoid slow operations
# GIT_EXECUTION_MODE=local

# Timeout for git operations in seconds
# GIT_OPERATION_TIMEOUT=60

# Remote git execution settings (required when GIT_EXECUTION_MODE=remote)
# GIT_REMOTE_HOST=your-server-hostname
# GIT_REMOTE_USER=your-ssh-username
# GIT_REMOTE_PATH=/path/to/repo
